# AI Video Growth Studio - Environment Configuration
# Copy this file to .env and fill in your values

# === Required ===
APP_DATA_DIR=./data
TTS_PROVIDER=volcengine

# === AI Models ===
AI_PROVIDER=qwen
AI_TEXT_MODEL=qwen-max
DEEPSEEK_API_KEY=

# === Volcengine / Doubao TTS ===
VOLCENGINE_APP_ID=
VOLCENGINE_TOKEN=
VOLCENGINE_VOICE_TYPE=

# === Cloudflare R2 Storage ===
R2_ENABLED=false
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=

# === Supabase ===
SUPABASE_URL=
SUPABASE_KEY=

# === Digital Human (optional) ===
ENABLE_DIGITAL_HUMAN=false
DIGITAL_HUMAN_ENGINE=jimeng
DIGITAL_HUMAN_WEBHOOK_URL=
DIGITAL_HUMAN_WEBHOOK_TOKEN=
DIGITAL_HUMAN_TIMEOUT_SECONDS=900

# === FAL Lipsync ===
FAL_KEY=

# === Volcengine Jimeng / OmniHuman ===
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
JIMENG_WAIT_FOR_RESULT=false

# === MiniMax / Hailuo (experimental) ===
MINIMAX_ENABLED=false
MINIMAX_API_KEY=
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-2.3
MINIMAX_TTS_MODEL=

# === Dev / Test ===
ALLOW_MOCK_TTS=false
