# AI-VIDEO Collector Worker
# 复制为 .env 后填写。token 在 ECS：cat /root/ai_video_collector_token.txt

API_BASE_URL=https://ai-video.47-76-143-158.sslip.io
HEAT_RADAR_INGEST_TOKEN=这里填ECS里的collector_token
AUTO_COLLECTOR_CRON_TOKEN=这里填同一个collector_token

# 采集范围
KEYWORDS=马来西亚房产,第二家园,海外置业,马来西亚生活
BATCH_ACCOUNT_LIMIT=1
LIMIT_PER_ACCOUNT=3
PINNED_LIMIT=1
RECENT_DAYS=3
MIN_DELAY_SECONDS=90
MAX_DELAY_SECONDS=180

# 浏览器 / 登录
HEADLESS=false
USER_DATA_DIR=profiles/douyin
USE_BROWSER_PROFILE=true
AUTO_REFRESH_COOKIES=true
YT_DLP_COOKIES_PATH=douyin_cookies.txt

# 上传 / 视频解析
UPLOAD_MODE=video_intake
IMMEDIATE_VIDEO_INTAKE=true
PER_VIDEO_PAGE_ENABLED=true
PER_VIDEO_PAGE_LIMIT=3
VIDEO_PAGE_TIMEOUT_MS=60000
VIDEO_PAGE_WAIT_MS=4500
VIDEO_RESOLVE_MODE=auto
VIDEO_RESOLVE_CHAIN=yt_dlp,cobalt,text
YT_DLP_ENABLED=true
VIDEO_DOWNLOAD_DIR=downloads
VIDEO_DOWNLOAD_TIMEOUT=120
COBALT_API_URL=
ALLOW_TEXT_FALLBACK=true

# 状态
OUTPUT_DIR=output
STATE_DB=collector_state.sqlite3
LOCK_FILE=collector.lock
COMMAND_POLL_INTERVAL_SECONDS=5
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
