# 视频解析增强配置：复制到 .env 末尾即可
VIDEO_RESOLVE_MODE=auto
VIDEO_RESOLVE_CHAIN=yt_dlp,cobalt,text
AUTO_REFRESH_COOKIES=true
USE_BROWSER_PROFILE=true
YT_DLP_ENABLED=true
YT_DLP_COOKIES_PATH=douyin_cookies.txt
VIDEO_DOWNLOAD_DIR=downloads
VIDEO_DOWNLOAD_TIMEOUT=120
# 自建 Cobalt 兜底，暂时没有就留空；不要依赖别人免费公共站
COBALT_API_URL=
ALLOW_TEXT_FALLBACK=true
